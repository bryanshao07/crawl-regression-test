# Ignore everything by default
*

# Allow these specific files only
!.gitignore
!README.md
!run_test_matrix.py

# Allow baselines folder but only the template inside it
!baselines/
baselines/*
!baselines/baseline_template.json
!baselines/baseline_apob.json
!baselines/baseline_nextdish.json

# Allow crawls and reports folders and all their contents
!crawls/
!crawls/**

!reports/
!reports/**

!site-structure-used-for-baseline/
!site-structure-used-for-baseline/**

# Explicitly ignore sensitive and generated files
.env
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
.vscode/
.idea/