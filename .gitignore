# Ignore everything by default
*

# Allow these specific files only
!.gitignore
!README.md
!run_test_matrix.py

# Allow baselines folder but only the template inside it
!baselines/
baselines/*
!baselines/baseline_template.json

# Allow crawls and reports folders but keep them empty
!crawls/
crawls/*
!crawls/.gitkeep

!reports/
reports/*
!reports/.gitkeep

# Explicitly ignore sensitive and generated files
.env
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
.vscode/
.idea/